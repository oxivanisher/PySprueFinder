# Single shared admin password. PySprueFinder is meant for internal networks
# only; this is the only authentication there is.
ADMIN_PASSWORD=changeme
# Signs the admin session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is used and admins are logged out on every restart.
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./instance/spruefinder.db
UPLOAD_DIR=./uploads

# Optional OCR tuning
# OCR_MIN_SCORE=0.7
# OCR_FONT_SIZE_TOLERANCE=0.35
